---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    padding-block: 0;
    --scroll-padding: max(1rem, 50% - 50rem / 2);
    display: flex;
    gap: var(--card-gap, 1.5rem);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
    scroll-snap-type: x mandatory;
    padding-inline: var(--scroll-padding);
    scroll-padding-inline:var(--scroll-padding);

  }

  li {
    flex: 1 0 400px;
    padding: var(--card-padding, 1.5rem);
    background: var(--card-background, #ffffff);
    color: var(--card-text-color, #333333);
    border-radius: var(--card-border-radius, 0.5rem);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  p {
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    ul {
      padding: 1rem;
    }
    
    li {
      width: 400px;
    }
  }
</style>
